{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shikosai-signage-api",
  "account_id": "617bef5ab8279861ced319f362981d45",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "signage-db",
      "database_id": "145a4780-fbdb-4766-8981-1ec06d597735"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "shikosai-signage-backups"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
